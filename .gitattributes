# Store and check out text files with LF line endings on every OS.
# The app runs in Linux containers, where CRLF breaks shell scripts ("bad interpreter")
# and makes diffs noisy. This overrides each developer's core.autocrlf setting.
* text=auto eol=lf

# Windows-only scripts genuinely need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch binary files
*.png binary
*.jpg binary
*.ico binary
*.gz binary
*.zip binary
