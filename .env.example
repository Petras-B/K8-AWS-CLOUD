# Copy this file to .env and replace the values with your local setup
DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/database_name

# Used only by pytest. Must be a separate, disposable database: tests run migrations against it
TEST_DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/database_name_test

# Optional (defaults shown)
# LOG_LEVEL=INFO
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_CONNECT_TIMEOUT=3
